# PostgreSQL connection. Mapped to ConnectionStrings:DefaultConnection.
# Either an Npgsql string (below) or a URL:
#   postgres://user:password@host:5432/dbname?sslmode=require
# Leave unset locally to use appsettings.Development.json.
DATABASE_URL=Host=localhost;Port=5432;Database=pmplatform;Username=pmuser;Password=pmpassword
# JWT signing key. Mapped to Jwt:SigningKey.
# REQUIRED outside Development: the API refuses to start unless this is a
# private random value of at least 32 bytes (and not this placeholder or
# the key in appsettings.Development.json). Generate one with e.g.
#   openssl rand -base64 48
# In Development a missing/short value falls back to appsettings.Development.json.
JWT_SECRET=replace_with_any_long_random_string_at_least_64_chars_long
GEMINI_API_KEY=
# Video meetings (F2-20). All three required for rooms to open — leave
# blank to keep video disabled (the UI shows "video not configured").
# Easiest dev setup: a free LiveKit Cloud project (https://cloud.livekit.io)
# gives you the wss:// URL + key + secret. Or run `livekit-server --dev`
# locally (URL ws://localhost:7880, key "devkey", secret "secret").
LIVEKIT_URL=
LIVEKIT_API_KEY=
# Either name works — LiveKit Cloud calls it "API Secret".
LIVEKIT_API_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
FRONTEND_URL=http://localhost:5173
# Public base URL of THIS API — used for the GitHub OAuth redirect_uri
# and the repo webhook payload URL (F2-23). Must match the GitHub OAuth
# App callback registration.
API_BASE_URL=http://localhost:5080
# Production behind a TLS-terminating reverse proxy / load balancer: set
# this so HTTPS redirection, HSTS and per-IP rate limiting see the real
# scheme and client IP from X-Forwarded-Proto / X-Forwarded-For.
# ASPNETCORE_FORWARDEDHEADERS_ENABLED=true